# CyberShield-AI Environment Configuration
# Copy to .env and fill in real values. Never commit .env to version control.

# Database (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./cybershield.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cybershield

# Application
APP_NAME=CyberShield-AI
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=CHANGE_ME_USE_LONG_RANDOM_STRING_IN_PRODUCTION

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Threat Intelligence Providers
# Get free key at https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# URLhaus is enabled by default - free, no key required
URLHAUS_ENABLED=true

# Rate Limiting
RATE_LIMIT_SCANS_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=100

# Extension
EXTENSION_SECRET=
RULE_SYNC_MAX_RULES=5000

# Scanning
SCAN_TIMEOUT_SECONDS=30
MAX_URL_LENGTH=2048
